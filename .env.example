# Vercel / Client Environment Variables
# In Vite, client-accessible variables must begin with VITE_
# Add these in your Vercel Project Settings -> Environment Variables

# Site Name / Brand
VITE_SITE_NAME="CopaGlobe - FIFA World Cup Chronicles"

# Canonical URL of the deployed application (e.g., https://your-app.vercel.app)
VITE_SITE_URL="https://copaglobe.vercel.app"

# Support / Editorial Contact Email
VITE_EDITORIAL_EMAIL="editorial@copaglobe.football"
